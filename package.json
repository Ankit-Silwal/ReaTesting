{
  "name": "relay-api-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "desktop": "node scripts/run.mjs desktop dev",
    "desktop:build": "node scripts/run.mjs desktop build",
    "test:rust": "node scripts/run.mjs cargo test -p relay-core --jobs 1",
    "check:rust": "node scripts/run.mjs cargo check --workspace",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:native": "node scripts/verify-native.mjs",
    "format": "prettier --write src e2e scripts *.ts *.json README.md docs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "lucide-react": "^1.58.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.5"
  }
}
